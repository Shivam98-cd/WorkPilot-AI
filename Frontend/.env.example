# ============================================================================
# WorkPilot AI - Frontend Environment Variables
# ============================================================================
# This file contains all environment variables needed for the React frontend.
# Copy this file to .env.local and fill in your actual values.
#
# IMPORTANT: 
# - .env.local is gitignored and should contain your REAL credentials
# - This .env.example should NEVER contain real API keys or secrets
# - All frontend env vars must start with VITE_ to be exposed to the browser
# ============================================================================

# ── Backend API Configuration ──────────────────────────────────────────────
# The backend API base URL that the frontend will communicate with
#
# Development: http://localhost:8000/api/v1
# Production:  https://your-backend.onrender.com/api/v1
#
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ── Firebase Configuration ─────────────────────────────────────────────────
# Get these values from Firebase Console:
# 1. Go to https://console.firebase.google.com
# 2. Select your project
# 3. Click the gear icon → Project Settings
# 4. Scroll down to "Your apps" section
# 5. Select your web app or create one
# 6. Copy the firebaseConfig values
#
# NOTE: These are PUBLIC values safe to expose in the browser.
# The Firebase API Key is NOT a secret - it's meant to be public.
# Security is enforced by Firebase Security Rules and backend validation.

VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ============================================================================
# Production Deployment Notes
# ============================================================================
#
# For Vercel deployment:
# 1. Go to your Vercel project dashboard
# 2. Navigate to Settings → Environment Variables
# 3. Add all VITE_* variables above with your production values
# 4. Make sure VITE_API_BASE_URL points to your Render backend URL
#
# Example production values:
# VITE_API_BASE_URL=https://workpilot-backend.onrender.com/api/v1
# VITE_FIREBASE_PROJECT_ID=workpilot-prod-xxxxx
#
# ============================================================================
