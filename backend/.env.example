PROJECT_NAME=WorkPilot AI
VERSION=1.0.0
API_PREFIX=/api/v1
DEBUG=True
# PORT is optional - defaults to 8000 for local dev, Render provides it automatically in production
PORT=8000


# Firebase Configuration
# Get these from Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project.iam.gserviceaccount.com

# JWT Configuration
# Generate a secure random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_KEY_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
# Development: http://localhost:5173
# Production: https://your-app.vercel.app (add your actual Vercel domain)
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Trusted Hosts (only enforced when DEBUG=False)
# Production: your-backend.onrender.com,your-app.vercel.app
ALLOWED_HOSTS=*

# Optional (for production)
REDIS_URL=redis://localhost:6379
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@workpilot.ai

# ── Integration OAuth Credentials ──────────────────────────────────────────
# Google OAuth (Gmail, Calendar, Drive, Meet)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth (Outlook, Teams, Microsoft 365)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Zoom OAuth
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Notion OAuth
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Jira (Atlassian) OAuth
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# Trello OAuth
TRELLO_API_KEY=
TRELLO_API_SECRET=

# ── AI/LLM API Keys ────────────────────────────────────────────────────────
# Groq API (Primary LLM for chat & automation)
GROQ_API_KEY=

# Gemini API (Used for morning briefings)
GEMINI_API_KEY=

# ── Integration Runtime Settings ──────────────────────────────────────────
# Backend URL - Production: https://your-backend.onrender.com
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
# Frontend OAuth callback - Production: https://your-app.vercel.app/dashboard
FRONTEND_OAUTH_REDIRECT=http://localhost:5173/dashboard
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_TOKEN_ENCRYPTION_KEY=GENERATE_A_NEW_KEY_FOR_PRODUCTION

# Agent Configuration
SYNC_INTERVAL_MINUTES=15
MAX_CONCURRENT_SYNCS=5
AGENT_TIMEOUT_SECONDS=30
EXTERNAL_REQUEST_TIMEOUT_SECONDS=10
RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=5

# Firestore Database Name
# Standard Firebase projects use "(default)" with parentheses
# Enterprise Firebase projects may use "default" without parentheses
# If you see warnings about database initialization, try switching between these
FIRESTORE_DATABASE=(default)
